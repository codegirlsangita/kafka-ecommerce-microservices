# --------------------------------------
# Global Kafka configuration
# --------------------------------------
# For local run from host machine use localhost:9092
# For services running inside Docker network use kafka:29092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=microservice

# --------------------------------------
# Kafka topics
# --------------------------------------
KAFKA_TOPIC_USER_CREATED=user.created
KAFKA_TOPIC_ORDER_CREATED=order.created
KAFKA_TOPIC_PAYMENT_COMPLETED=payment.completed
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# --------------------------------------
# Kafka consumer groups
# --------------------------------------
KAFKA_CONSUMER_GROUP_ORDER=order-service-group
KAFKA_CONSUMER_GROUP_PAYMENT=payment-service-group
KAFKA_CONSUMER_GROUP_NOTIFICATION=notification-service-group

# --------------------------------------
# MongoDB connection strings
# --------------------------------------
USER_MONGODB_URI=mongodb://admin:password@localhost:27017/user_db?authSource=admin
ORDER_MONGODB_URI=mongodb://admin:password@localhost:27017/order_db?authSource=admin
PAYMENT_MONGODB_URI=mongodb://admin:password@localhost:27017/payment_db?authSource=admin
NOTIFICATION_MONGODB_URI=mongodb://admin:password@localhost:27017/notification_db?authSource=admin

# Optional fallback URI if service-specific URI is not set
MONGODB_URI=mongodb://admin:password@localhost:27017/app_db?authSource=admin

# --------------------------------------
# Service ports
# --------------------------------------
USER_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004

# --------------------------------------
# Logging
# --------------------------------------
LOG_LEVEL=info
